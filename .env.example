# ── Summarization Backend ──────────────────────────────────────────────
# Which backend to use for summarization.  Default: openrouter.
#   openrouter  — cloud LLM via OpenRouter (needs OPENROUTER_API_KEY)
#   ollama      — local Ollama server (http://localhost:11434/v1, no key)
#   llamacpp    — local llama.cpp server (http://localhost:8080/v1, no key)
#   local       — any OpenAI-compatible local endpoint (set SUMMARIZE_BASE_URL)
# You can cycle backends at runtime with B in the TUI.
SUMMARIZE_BACKEND=openrouter

# ── OpenRouter (cloud) ─────────────────────────────────────────────────
# Required when SUMMARIZE_BACKEND=openrouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# ── Local backends (ollama / llamacpp / lmstudio / local) ────────────
# Model name for the selected local backend.  For Ollama, run `ollama list`
# to see available models.  For llama.cpp / LM Studio, use the model name
# you loaded.
# SUMMARIZE_MODEL=hermes-qwen35b:latest
# OLLAMA_MODEL=hermes-qwen35b:latest
# LLAMACPP_MODEL=
# LMSTUDIO_MODEL=
#
# Override the default base URL for any backend:
# Ollama default:    http://localhost:11434/v1
# llamacpp default:  http://localhost:8080/v1
# LM Studio default: http://localhost:1234/v1
# SUMMARIZE_BASE_URL=http://localhost:11434/v1

# ── Whisper (always local) ─────────────────────────────────────────────
# Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base